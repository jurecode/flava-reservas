# Ruta: /.env.example  (copiar a /.env — NUNCA versionar el real)

APP_NAME="Flava Studio"
APP_URL=https://flava.cl
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=America/Santiago
APP_LOCALE=es_CL
APP_CURRENCY=CLP
# php bin/flava key:generate
APP_KEY=

SESSION_SECURE=true

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=flava_db
DB_USERNAME=
DB_PASSWORD=

# ---- GitHub / Deploy (panel SUPER_ADMIN) ----
GITHUB_ENABLED=false
GITHUB_OWNER=
GITHUB_REPOSITORY=
GITHUB_BRANCH=main
# Fine-grained PAT con permisos mínimos: Contents=Read, Metadata=Read
GITHUB_TOKEN=
GITHUB_REPO_PATH=
DEPLOY_STRATEGY=auto

# ---- Email (Etapa 2) ----
MAIL_DRIVER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hola@flava.cl
MAIL_FROM_NAME="Flava Studio"

# ---- WhatsApp (Etapa 2) ----
WHATSAPP_DRIVER=log
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=
